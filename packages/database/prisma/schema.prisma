  createdAt        DateTime @default(now()) @map("created_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event      CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([tenantId])
  @@map("calendar_event_attachments")
}

/// Fase 2 — agendamento de emissão/envio de faturas (ligação billing + calendário).
model CalendarScheduledInvoice {
  id              String                         @id @default(uuid()) @db.Uuid
  tenantId        String                         @map("tenant_id") @db.Uuid
  workspaceId     String                         @map("workspace_id") @db.Uuid
  eventId         String?                        @map("event_id") @db.Uuid
