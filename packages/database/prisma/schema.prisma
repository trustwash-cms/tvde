// ─── Calendar ───────────────────────────────────────────────────────────────

enum CalendarVisibility {
  private
  workspace
  shared
}

enum CalendarMemberRole {
  owner
  editor
  viewer
}

enum CalendarEventStatus {
  confirmed
  tentative
  cancelled
}

enum CalendarAttendeeRole {
  organizer
  required
  optional
}

enum CalendarAttendeeResponse {
  needs_action
  accepted
  declined
  tentative
}

enum CalendarReminderChannel {
  in_app
  email
  push
}

enum CalendarReminderStatus {
  pending
  sent
  dismissed
  skipped
}

enum CalendarScheduledInvoiceStatus {
  pending
  processing
  completed
  failed
  cancelled
}

/// Calendário partilhável (tipo Google Calendar) — scope workspace + ACL por utilizador.
model Calendar {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  ownerUserId String             @map("owner_user_id") @db.Uuid
  name        String
  description String?            @db.Text
  color       String             @default("#3b82f6")
  timezone    String             @default("Europe/Lisbon")
  visibility  CalendarVisibility @default(private)
  isDefault   Boolean            @default(false) @map("is_default")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User             @relation("CalendarOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members              CalendarMember[]
  events               CalendarEvent[]
  bookingProfilesDefault BookingProfile[] @relation("BookingDefaultCalendar")
  bookingSettingsDefault BookingSettings[] @relation("BookingSettingsDefaultCalendar")

  @@index([tenantId, workspaceId])
  @@index([ownerUserId])
  @@map("calendars")
}

/// ACL ao nível do calendário (partilha persistente com múltiplos utilizadores).
model CalendarMember {
  id              String             @id @default(uuid()) @db.Uuid
  calendarId      String             @map("calendar_id") @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  role            CalendarMemberRole @default(viewer)
  notifyChanges   Boolean            @default(true) @map("notify_changes")
  addedAt         DateTime           @default(now()) @map("added_at")
  addedByUserId   String?            @map("added_by_user_id") @db.Uuid

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedBy  User?    @relation("CalendarMemberAddedBy", fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@unique([calendarId, userId])
  @@index([userId])
  @@map("calendar_members")
}

/// Evento (suporta drag-and-drop via start_at/end_at, recorrência RRULE, excepções).
model CalendarEvent {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  workspaceId      String              @map("workspace_id") @db.Uuid
  calendarId       String              @map("calendar_id") @db.Uuid
  createdByUserId  String              @map("created_by_user_id") @db.Uuid
  title            String
  description      String?             @db.Text
  location         String?
  startAt          DateTime            @map("start_at") @db.Timestamptz(6)
  endAt            DateTime            @map("end_at") @db.Timestamptz(6)
  allDay           Boolean             @default(false) @map("all_day")
  timezone         String              @default("Europe/Lisbon")
  status           CalendarEventStatus @default(confirmed)
  color            String?
  recurrenceRule   String?             @map("recurrence_rule")
  recurrenceUntil  DateTime?           @map("recurrence_until") @db.Timestamptz(6)
  seriesMasterId   String?             @map("series_master_id") @db.Uuid
  originalStartAt  DateTime?           @map("original_start_at") @db.Timestamptz(6)
  metadataJson     Json                @default("{}") @map("metadata_json")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  calendar     Calendar                  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  createdBy    User                      @relation("CalendarEventCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  seriesMaster CalendarEvent?            @relation("EventSeries", fields: [seriesMasterId], references: [id], onDelete: Cascade)
  exceptions   CalendarEvent[]           @relation("EventSeries")
  attendees    CalendarEventAttendee[]
  reminders    CalendarEventReminder[]
  attachments  CalendarEventAttachment[]
  scheduledInvoices CalendarScheduledInvoice[]
  bookings     Booking[]

  @@index([calendarId, startAt, endAt])
  @@index([tenantId, workspaceId, startAt])
  @@index([seriesMasterId])
  @@map("calendar_events")
}

/// Convidados por evento (partilha granular — utilizadores com acesso ao conteúdo).
model CalendarEventAttendee {
  id              String                   @id @default(uuid()) @db.Uuid
  eventId         String                   @map("event_id") @db.Uuid
  userId          String                   @map("user_id") @db.Uuid
  role            CalendarAttendeeRole     @default(required)
  responseStatus  CalendarAttendeeResponse @default(needs_action) @map("response_status")
  canEdit         Boolean                  @default(false) @map("can_edit")
  notify          Boolean                  @default(true)
  invitedAt       DateTime                 @default(now()) @map("invited_at")
  invitedByUserId String?                  @map("invited_by_user_id") @db.Uuid

  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?         @relation("CalendarAttendeeInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("calendar_event_attendees")
}

/// Lembretes / alertas (dashboard, email, push futuro). fire_at indexado para worker.
model CalendarEventReminder {
  id            String                  @id @default(uuid()) @db.Uuid
  tenantId      String                  @map("tenant_id") @db.Uuid
  eventId       String                  @map("event_id") @db.Uuid
  userId        String                  @map("user_id") @db.Uuid
  offsetMinutes Int                     @map("offset_minutes")
  channel       CalendarReminderChannel @default(in_app)
  fireAt        DateTime                @map("fire_at") @db.Timestamptz(6)
  status        CalendarReminderStatus  @default(pending)
  sentAt        DateTime?               @map("sent_at") @db.Timestamptz(6)
  dismissedAt   DateTime?               @map("dismissed_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fireAt, status])
  @@index([eventId])
  @@index([tenantId, status, fireAt])
  @@map("calendar_event_reminders")
}

/// Anexos de eventos (storage_key aponta para S3/disco — módulo media futuro).
model CalendarEventAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  eventId          String   @map("event_id") @db.Uuid
  fileName         String   @map("file_name")
  storageKey       String   @map("storage_key")
