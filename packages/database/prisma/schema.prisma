  billingEntityId String                         @map("billing_entity_id") @db.Uuid
  scheduledAt     DateTime                       @map("scheduled_at") @db.Timestamptz(6)
  status          CalendarScheduledInvoiceStatus @default(pending)
  draftPayloadJson Json                          @map("draft_payload_json")
