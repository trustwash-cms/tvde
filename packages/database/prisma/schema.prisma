generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Core ───────────────────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(uuid()) @db.Uuid
  siteId      String   @unique @map("site_id")
  name        String
  plan        String   @default("starter")
  limitsJson  Json     @default("{}") @map("limits_json")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspaces     Workspace[]
  users          User[]
  loginAttempts  LoginAttempt[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]
  clients        Client[]
  products       Product[]
  services       Service[]
  invoices       Invoice[]
  billingEntities BillingEntity[]
  smtpConfigs    SmtpConfig[]
  emailTemplates EmailTemplate[]
  tenantSettings TenantSetting[]
  auditLogs      AuditLog[]
  tenantModules  TenantModule[]
  workspaceRequests WorkspaceRequest[]
  whatsappTemplates WhatsappTemplate[]
  calendars              Calendar[]
  calendarEvents           CalendarEvent[]
  calendarEventReminders   CalendarEventReminder[]
  calendarEventAttachments CalendarEventAttachment[]
  calendarScheduledInvoices CalendarScheduledInvoice[]
  ecommerceProducts         EcommerceProduct[]
  ecommerceProductImages    EcommerceProductImage[]
  ecommerceMediaAssets      EcommerceMediaAsset[]
  ecommerceCategories       EcommerceCategory[]
  ecommerceBrands           EcommerceBrand[]
  ecommerceModels           EcommerceModel[]
  ecommerceNavItems         EcommerceNavItem[]
  ecommerceCustomers        EcommerceCustomer[]
  ecommerceOrders           EcommerceOrder[]
  carwashEntities           CarwashEntity[]
  carwashCatalogItems       CarwashCatalogItem[]
  carwashVehicles           CarwashVehicle[]
  carwashWorkSheets         CarwashWorkSheet[]
  carwashWorkSheetLines     CarwashWorkSheetLine[]
  carwashDailyCashSheets    CarwashDailyCashSheet[]
  bookingCatalogItems       BookingCatalogItem[]
  bookings                  Booking[]
  bookingProfiles           BookingProfile[]
  stripePaymentRequests     StripePaymentRequest[]
  adminMgmtSeguros          AdminMgmtSeguro[]
  adminMgmtContratos        AdminMgmtContrato[]
  adminMgmtDespesasPessoal  AdminMgmtDespesaPessoal[]
  adminMgmtSegurancaSocial  AdminMgmtSegurancaSocial[]
  adminMgmtIrsEmpresa       AdminMgmtIrsEmpresa[]
  adminMgmtIva              AdminMgmtIva[]
  adminMgmtRecibosVerdes    AdminMgmtReciboVerde[]
  adminMgmtVencimentos      AdminMgmtVencimento[]
  adminMgmtClientes         AdminMgmtCliente[]
  adminMgmtFaturas          AdminMgmtFatura[]
  adminMgmtLancamentos      AdminMgmtLancamento[]
  adminMgmtImportacoes      AdminMgmtImportacao[]
  boltConnections           BoltConnection[]
  boltOrders                BoltOrder[]
  boltDrivers               BoltDriver[]
  boltVehicles              BoltVehicle[]
  boltSyncLogs              BoltSyncLog[]

  @@map("tenants")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  slug      String
  type      String   @default("general")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users            User[]
  workspaceModules WorkspaceModule[]
  webhooks         Webhook[]
  clients          Client[]
  products         Product[]
  services         Service[]
  invoices         Invoice[]
  billingEntities  BillingEntity[]
  billingCatalogItems BillingCatalogItem[]
  billingSyncConflicts BillingSyncConflict[]
  workspaceSettings WorkspaceSetting[]
  workspaceRequests WorkspaceRequest[]
  billingConnection BillingConnection?
  wooCommerceConnection WooCommerceConnection?
  shopifyConnection     ShopifyConnection?
  ecommerceSettings   EcommerceSettings?
  ecommerceProducts   EcommerceProduct[]
  ecommerceProductImages EcommerceProductImage[]
  ecommerceMediaAssets   EcommerceMediaAsset[]
  ecommerceCategories EcommerceCategory[]
  ecommerceBrands     EcommerceBrand[]
  ecommerceModels     EcommerceModel[]
  ecommerceNavItems   EcommerceNavItem[]
  ecommerceCustomers  EcommerceCustomer[]
  ecommerceOrders     EcommerceOrder[]
  carwashEntities     CarwashEntity[]
  carwashCatalogItems CarwashCatalogItem[]
  carwashVehicles     CarwashVehicle[]
  carwashWorkSheets   CarwashWorkSheet[]
  carwashWorkSheetLines CarwashWorkSheetLine[]
  carwashDailyCashSheets CarwashDailyCashSheet[]
  calendars              Calendar[]
  calendarEvents           CalendarEvent[]
  calendarScheduledInvoices CalendarScheduledInvoice[]
  bookingSettings         BookingSettings?
  bookingProfiles         BookingProfile[]
  bookingCatalogItems     BookingCatalogItem[]
  bookings                Booking[]
  stripeConnection        StripeConnection?
  correosExpressConnection CorreosExpressConnection?
  stripePaymentRequests   StripePaymentRequest[]
  adminMgmtSeguros        AdminMgmtSeguro[]
  adminMgmtContratos      AdminMgmtContrato[]
  adminMgmtDespesasPessoal AdminMgmtDespesaPessoal[]
  adminMgmtSegurancaSocial AdminMgmtSegurancaSocial[]
  adminMgmtIrsEmpresa     AdminMgmtIrsEmpresa[]
  adminMgmtIva            AdminMgmtIva[]
  adminMgmtRecibosVerdes  AdminMgmtReciboVerde[]
  adminMgmtVencimentos    AdminMgmtVencimento[]
  adminMgmtClientes       AdminMgmtCliente[]
  adminMgmtFaturas        AdminMgmtFatura[]
  adminMgmtLancamentos    AdminMgmtLancamento[]
  adminMgmtImportacoes    AdminMgmtImportacao[]
  boltConnection          BoltConnection?
  boltOrders              BoltOrder[]
  boltDrivers             BoltDriver[]
  boltVehicles            BoltVehicle[]
  boltSyncLogs            BoltSyncLog[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("workspaces")
}

enum WorkspaceRequestStatus {
  pending
  approved
  rejected
}

model WorkspaceRequest {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  requestedBy String                 @map("requested_by") @db.Uuid
  name        String
  slug        String
  type        String                 @default("general")
  status      WorkspaceRequestStatus @default(pending)
  reviewedBy  String?                @map("reviewed_by") @db.Uuid
  reviewNote  String?                @map("review_note")
  reviewedAt  DateTime?              @map("reviewed_at")
  workspaceId String?                @map("workspace_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester User       @relation("WorkspaceRequestRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  reviewer  User?      @relation("WorkspaceRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("workspace_requests")
}

enum UserRole {
  master
  superadmin
  admin
  staff
}

enum UserStatus {
  active
  suspended
  pending
}

enum TwoFaMethod {
  email
  totp
  sms
  whatsapp
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String?     @map("tenant_id") @db.Uuid
  workspaceId  String?     @map("workspace_id") @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         UserRole    @default(staff)
  status       UserStatus  @default(pending)
  twoFaMethod      TwoFaMethod? @map("two_fa_method")
  twoFaSecret      String?      @map("two_fa_secret")
  backupCodes      String[]     @default([]) @map("backup_codes")
  phone            String?
  phoneVerifiedAt  DateTime?    @map("phone_verified_at")
  lastLoginAt          DateTime? @map("last_login_at")
  mustChangePassword   Boolean   @default(false) @map("must_change_password")
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  tenant               Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace            Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  sessions             Session[]
  passwordHistory      PasswordHistory[]
  passwordResetTokens  PasswordResetToken[]
  twoFaCodes           TwoFaCode[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  smsLogs              SmsLog[]
  workspaceRequests    WorkspaceRequest[] @relation("WorkspaceRequestRequester")
  reviewedWorkspaceRequests WorkspaceRequest[] @relation("WorkspaceRequestReviewer")
  ownedCalendars           Calendar[] @relation("CalendarOwner")
  calendarMemberships      CalendarMember[]
  calendarMembersAdded     CalendarMember[] @relation("CalendarMemberAddedBy")
  calendarEventsCreated    CalendarEvent[] @relation("CalendarEventCreator")
  calendarAttendees          CalendarEventAttendee[]
  calendarAttendeesInvited   CalendarEventAttendee[] @relation("CalendarAttendeeInvitedBy")
  calendarReminders          CalendarEventReminder[]
  calendarAttachmentsUploaded CalendarEventAttachment[]
  calendarScheduledInvoicesCreated CalendarScheduledInvoice[]
  ownedBookingProfiles             BookingProfile[] @relation("BookingProfileOwner")
  carwashDailyCashSheetsClosed     CarwashDailyCashSheet[] @relation("CarwashDailyCashSheetClosedBy")

  @@index([tenantId])
  @@index([workspaceId])
  @@map("users")
}

// ─── Auth & Sessions ────────────────────────────────────────────────────────

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  tokenHash  String   @map("token_hash")
  ipAddress  String?  @map("ip_address")
  deviceInfo String?  @map("device_info")
  userAgent  String?  @map("user_agent")
  isActive   Boolean  @default(true) @map("is_active")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("sessions")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @map("tenant_id") @db.Uuid
  email         String
  ipAddress     String   @map("ip_address")
  success       Boolean
  failureReason String?  @map("failure_reason")
  attemptedAt   DateTime @default(now()) @map("attempted_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([email, ipAddress])
  @@index([attemptedAt])
  @@map("login_attempts")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_history")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model TwoFaCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  method    String
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_fa_codes")
}

// ─── Modules ────────────────────────────────────────────────────────────────

model ModuleRegistry {
  key         String  @id
  name        String
  version     String  @default("1.0.0")
  description String?
  isCore      Boolean @default(false) @map("is_core")

  workspaceModules WorkspaceModule[]
  tenantModules    TenantModule[]

  @@map("module_registry")
}

model TenantModule {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  moduleKey String    @map("module_key")
  allowed   Boolean   @default(true)
  allowedAt DateTime? @map("allowed_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module ModuleRegistry @relation(fields: [moduleKey], references: [key])

  @@unique([tenantId, moduleKey])
  @@index([tenantId])
  @@map("tenant_modules")
}

model WorkspaceModule {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  moduleKey   String    @map("module_key")
  enabled     Boolean   @default(true)
  configJson  Json      @default("{}") @map("config_json")
  enabledAt   DateTime? @map("enabled_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module    ModuleRegistry @relation(fields: [moduleKey], references: [key])

  @@unique([workspaceId, moduleKey])
  @@map("workspace_modules")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  keyHash    String    @unique @map("key_hash")
  name       String
  scopes     String[]  @default([])
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model Webhook {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  url         String
  events      String[] @default([])
  secretHash  String   @map("secret_hash")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs     WebhookLog[]

  @@index([tenantId])
  @@map("webhooks")
}

model WebhookLog {
  id            String   @id @default(uuid()) @db.Uuid
  webhookId     String   @map("webhook_id") @db.Uuid
  event         String
  httpStatus    Int      @map("http_status")
  attemptNumber Int      @map("attempt_number")
  sentAt        DateTime @default(now()) @map("sent_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@map("webhook_logs")
}

// ─── Business ───────────────────────────────────────────────────────────────

model Client {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  email       String?
  phone       String?
  nif                 String?
  externalCustomerId  String?  @map("external_customer_id")
  billingProvider     String?  @map("billing_provider")
  addressJson Json     @default("{}") @map("address_json")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  billingEntity  BillingEntity?
  bookings       Booking[]
  adminMgmtLinks AdminMgmtCliente[]

  @@index([tenantId, workspaceId])
  @@map("clients")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  sku         String
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  stockQty    Int      @default(0) @map("stock_qty")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, sku])
  @@index([tenantId, workspaceId])
  @@map("products")
}

model Service {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  workspaceId String  @map("workspace_id") @db.Uuid
  name        String
  price       Decimal @db.Decimal(12, 2)
  durationMin Int     @default(60) @map("duration_min")
  status      String  @default("active")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([tenantId, workspaceId])
  @@map("services")
}

model Invoice {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  clientId        String?   @map("client_id") @db.Uuid
  billingEntityId String?   @map("billing_entity_id") @db.Uuid
  number          String
  status      String    @default("draft")
  provider     String    @default("local")
  documentType String    @default("invoice") @map("document_type")
  entityType   String    @default("customer") @map("entity_type")
  externalId   String?   @map("external_id")
  subtotal    Decimal   @default(0) @db.Decimal(12, 2)
  vatAmount   Decimal   @default(0) @map("vat_amount") @db.Decimal(12, 2)
  total       Decimal   @default(0) @db.Decimal(12, 2)
  dueDate      DateTime? @map("due_date") @db.Date
  issuedAt     DateTime? @map("issued_at")
  emailSentAt  DateTime? @map("email_sent_at")
  notes        String?   @db.Text
  metadataJson Json?     @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client        Client?        @relation(fields: [clientId], references: [id])
  billingEntity BillingEntity? @relation(fields: [billingEntityId], references: [id])
  lines         InvoiceLine[]
  scheduledFromCalendar CalendarScheduledInvoice[]
  downloadTokens InvoiceDownloadToken[]

  @@unique([workspaceId, number])
  @@index([tenantId, workspaceId])
  @@index([billingEntityId])
  @@map("invoices")
}

model InvoiceDownloadToken {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([expiresAt])
  @@map("invoice_download_tokens")
}

model InvoiceLine {
  id                String  @id @default(uuid()) @db.Uuid
  invoiceId         String  @map("invoice_id") @db.Uuid
  productId         String? @map("product_id") @db.Uuid
  externalProductId String? @map("external_product_id")
  externalTaxId     String? @map("external_tax_id")
  description       String
  quantity          Int     @default(1)
  unitPrice         Decimal @map("unit_price") @db.Decimal(12, 2)
  vatRate           Decimal @default(23) @map("vat_rate") @db.Decimal(5, 2)
  lineTotal         Decimal @map("line_total") @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model BillingEntity {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  entityType        String    @map("entity_type")
  name              String
  vat               String?
  email             String?
  phone             String?
  addressJson       Json      @default("{}") @map("address_json")
  provider          String    @default("moloni")
  externalId        String?   @map("external_id")
  cmsClientId       String?   @unique @map("cms_client_id") @db.Uuid
  status            String    @default("active")
  linkStatus        String    @default("unlinked") @map("link_status")
  syncStatus        String    @default("synced") @map("sync_status")
  archivedAt        DateTime? @map("archived_at")
  moloniUpdatedAt   DateTime? @map("moloni_updated_at")
  cmsUpdatedAt      DateTime? @map("cms_updated_at")
  lastSyncedAt      DateTime? @map("last_synced_at")
  moloniPayloadJson Json      @default("{}") @map("moloni_payload_json")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cmsClient Client?               @relation(fields: [cmsClientId], references: [id], onDelete: SetNull)
  invoices  Invoice[]
  conflicts BillingSyncConflict[]
  scheduledInvoices CalendarScheduledInvoice[]
  carwashEntities   CarwashEntity[]
  adminMgmtLinks    AdminMgmtCliente[]

  @@unique([workspaceId, provider, entityType, externalId])
  @@index([tenantId, workspaceId])
  @@index([workspaceId, entityType])
  @@index([workspaceId, status])
  @@map("billing_entities")
}

model BillingSyncConflict {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  entityId    String    @map("entity_id") @db.Uuid
  cmsClientId String?   @map("cms_client_id") @db.Uuid
  field       String
  cmsValue    String?   @map("cms_value") @db.Text
  moloniValue String?   @map("moloni_value") @db.Text
  status      String    @default("open")
  resolution  String?
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entity    BillingEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([entityId])
  @@map("billing_sync_conflicts")
}

model BillingCatalogItem {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  catalogType String   @map("catalog_type")
  externalId  String   @map("external_id")
  label       String
  dataJson    Json     @default("{}") @map("data_json")
  syncedAt    DateTime @map("synced_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, catalogType, externalId])
  @@index([workspaceId, catalogType])
  @@map("billing_catalog_items")
}

model BillingConnection {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String    @unique @map("workspace_id") @db.Uuid
  provider              String    @default("moloni")
  clientId              String    @map("client_id")
  encryptedClientSecret String    @map("encrypted_client_secret")
  encryptedAccessToken  String?   @map("encrypted_access_token")
  encryptedRefreshToken String?   @map("encrypted_refresh_token")
  tokenExpiresAt        DateTime? @map("token_expires_at")
  companyId             Int?      @map("company_id")
  documentSetId         Int?      @map("document_set_id")
  redirectUri           String?   @map("redirect_uri")
  connectedAt           DateTime? @map("connected_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("billing_connections")
}

model WooCommerceConnection {
