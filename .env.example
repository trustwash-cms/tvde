# ─── Base de dados ───
DATABASE_URL="postgresql://tvde:tvde_secret@localhost:5433/tvde?schema=public"

# ─── Redis ───
REDIS_URL="redis://localhost:6380"

# ─── JWT ───
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_ACCESS_EXPIRES="8h"
JWT_REFRESH_EXPIRES="7d"

# ─── Encriptação (AES-256 para passwords SMTP) ───
ENCRYPTION_KEY="32-char-key-change-in-prod!!"

# ─── API ───
NODE_ENV=development
API_PORT=3002
API_HOST=0.0.0.0
API_PREFIX="/api/v1"
HEALTH_PATH="/health"
CORS_ORIGIN="http://localhost:3003"
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW="1 minute"

# ─── Frontend ───
WEB_PORT=3003
WEB_PUBLIC_URL="http://localhost:3003"
NEXT_PUBLIC_API_URL="http://localhost:3002/api/v1"
NEXT_PUBLIC_APP_NAME="Fleet CRM"
NEXT_PUBLIC_SHOW_DEMO_HINT="true"

# ─── Password reset ───
PASSWORD_RESET_EXPIRES="1h"
RESET_EXPOSE_TOKEN="true"

# ─── Seed (desenvolvimento) ───
SEED_MASTER_EMAIL="master@tvde.local"
SEED_MASTER_PASSWORD="Master@123456"
# Tenant demo (opcional) — SEED_DEMO=true + vars abaixo para recriar frota-demo no db:seed
# SEED_DEMO=true
# SEED_DEMO_SITE_ID="frota-demo"
# SEED_DEMO_TENANT_NAME="Frota Demo"
# SEED_DEMO_FLEET_MANAGER_EMAIL="gestor@frota-demo.local"
# SEED_DEMO_FLEET_MANAGER_PASSWORD="Gestor@123456"
# SEED_DEMO_DRIVER_EMAIL="motorista@frota-demo.local"
# SEED_DEMO_DRIVER_PASSWORD="Motorista@123456"

# HIBP — verificar passwords comprometidas (default: true em production, false em dev)
# HIBP_CHECK="true"

# ─── Facturação Moloni (credenciais por workspace na UI) ───
# Produção (tvde.one) — callback na API pública (não use fleet.tvde.one):
# NEXT_PUBLIC_API_PUBLIC_URL="https://api.tvde.one/api/v1"
# NEXT_PUBLIC_MOLONI_REDIRECT_URI="https://api.tvde.one/api/v1/billing/moloni/callback"
# API_PUBLIC_URL="https://api.tvde.one/api/v1"
# Moloni NÃO aceita localhost — em dev use túnel (ngrok http 3002 / cloudflared):
# NEXT_PUBLIC_API_PUBLIC_URL="https://SEU-ID.ngrok-free.app/api/v1"
# NEXT_PUBLIC_MOLONI_REDIRECT_URI="https://SEU-ID.ngrok-free.app/api/v1/billing/moloni/callback"
# BILLING_SYNC_SECRET="um-secret-forte"
# Link público de fatura (email): validade e nº máximo de downloads PDF
# INVOICE_DOWNLOAD_TOKEN_EXPIRES="90d"
# INVOICE_DOWNLOAD_MAX_COUNT="3"

# ─── Branding (logotipo nos emails — Config → SMTP) ───
# BRANDING_UPLOAD_DIR="uploads/branding"
# BRANDING_MAX_LOGO_BYTES=2097152
# BRANDING_MAX_WALLPAPER_BYTES=8388608

# ─── Portal RPA (Via Verde / MyPRIO / Uber) — ver docs/PORTAL_RPA.md ───
PORTAL_RPA_ENABLED=true
# Renovar cookies / manter sessão (horas). Requer API sempre a correr.
PORTAL_RPA_REFRESH_INTERVAL_HOURS=3
# Hora (0-23) do sync automático diário dos portais RPA (Europe/Lisbon)
PORTAL_DAILY_SYNC_HOUR=6
# false = Chromium real; true = mock (sem browsers). Em development, omitir = mock.
PORTAL_RPA_MOCK=false
PORTAL_RPA_HEADLESS=true
# Uber: true = janela Chromium visível e espera humana no servidor (só debug).
PORTAL_RPA_UBER_INTERACTIVE=false
# Uber Ligar conta: Chromium headed + Xvfb (DISPLAY) para Arkose pintar no modal Desafio Uber.
# Default: true se DISPLAY estiver definido. Não é o mesmo que UBER_INTERACTIVE.
PORTAL_RPA_UBER_HEADED_CONNECT=true
# Display virtual para Chromium headed (VM Linux). Ex.: :1 com Xvfb.
# DISPLAY=:1
# Depois de npm install: npm run playwright:install
